DATABASE_URL="postgresql://postgres:postgres@localhost:5432/duplo_saas?schema=public"
JWT_SECRET="troque-isso-por-uma-string-aleatoria-de-pelo-menos-32-chars"

# WebSocket
WS_PORT=3001
NEXT_PUBLIC_WS_URL="ws://localhost:3001"

# Pagamento — Mercado Pago Pix
# 1) ACCESS_TOKEN: criar em https://www.mercadopago.com.br/developers/panel/app -> Credenciais.
#    Use APP_USR-... de PRODUÇÃO pra cobrar de verdade; TEST-... só funciona em sandbox.
MP_ACCESS_TOKEN=""
# 2) WEBHOOK_SECRET: copiar da mesma página, seção Webhooks > "Chave secreta".
#    Em DEV pode deixar vazio que o webhook aceita sem validar assinatura.
MP_WEBHOOK_SECRET=""
# 3) APP_URL: URL pública que o MP vai chamar (ex: https://seu-dominio.com).
#    Em DEV use ngrok/cloudflared. Se vazio, o webhook é registrado sem notification_url.
APP_URL=""

# Outros
NODE_ENV="development"

# =========================================================================
# Dominios — fonte unica em src/lib/config.ts
# Quando trocar de odds-sable.vercel.app/duplo-saas.vercel.app para um
# dominio proprio (ex.: duplopro.com), atualize as 3 vars abaixo:
# =========================================================================

# URL publica do Duplo Pro (scanner). Usado pelo painel pra montar o link
# de afiliado (https://<DUPLO_PRO_URL>/r/<slug>).
NEXT_PUBLIC_DUPLO_PRO_URL="https://odds-sable.vercel.app"

# URL publica deste projeto (Duplo SaaS). Usado em e-mails, webhooks, etc.
NEXT_PUBLIC_DUPLO_SAAS_URL="https://duplo-saas.vercel.app"

# Origins extras autorizados a chamar /api/auth/sso-by-email (separados
# por virgula). O NEXT_PUBLIC_DUPLO_PRO_URL ja entra automaticamente.
# DUPLO_PRO_ORIGINS="https://www.duplopro.com,https://staging.duplopro.com"

# Origins extras pra CSP frame-ancestors (separados por espaco).
# FRAME_ANCESTORS_EXTRA="https://www.duplopro.com"
