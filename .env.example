DATABASE_URL="postgresql://postgres:postgres@localhost:5432/duplo_saas?schema=public"
JWT_SECRET="troque-isso-por-uma-string-aleatoria-de-pelo-menos-32-chars"

# WebSocket
WS_PORT=3001
NEXT_PUBLIC_WS_URL="ws://localhost:3001"

# Pagamento — Mercado Pago Pix
# 1) ACCESS_TOKEN: criar em https://www.mercadopago.com.br/developers/panel/app -> Credenciais.
#    Use APP_USR-... de PRODUÇÃO pra cobrar de verdade; TEST-... só funciona em sandbox.
MP_ACCESS_TOKEN=""
# 2) WEBHOOK_SECRET: copiar da mesma página, seção Webhooks > "Chave secreta".
#    Em DEV pode deixar vazio que o webhook aceita sem validar assinatura.
MP_WEBHOOK_SECRET=""
# 3) APP_URL: URL pública que o MP vai chamar (ex: https://seu-dominio.com).
#    Em DEV use ngrok/cloudflared. Se vazio, o webhook é registrado sem notification_url.
APP_URL=""

# Outros
NODE_ENV="development"
